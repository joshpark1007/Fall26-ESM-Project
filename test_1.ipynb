   "source": [
    "x = np.linspace(-10,10, 1000)\n",
    "def y(x):\n",
    "    return np.exp(-x**2)\n",
    "\n",
    "plt.plot(x,y(x),color='r',lw=3,label='Function')\n",
    "plt.xlabel('x')\n",
    "plt.ylabel('y')\n",
    "plt.title(\"Test Gaussian\")\n",
    "plt.legend()\n",
    "plt.grid(alpha=0.3)"
   ]
  }
